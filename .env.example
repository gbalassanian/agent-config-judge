# Copy to .env and fill in. Never commit the real file (.env is gitignored).

# ElevenLabs workspace to scan. Needed only for `fetch-portfolio` / the `live`
# ElevenLabs client backend. Header used: xi-api-key.
ELEVENLABS_API_KEY=

# Needed only for the judge's `live` backend (real Claude calls). Without it,
# everything in this repo still runs against the `recorded` backend — see
# README "Running without API keys".
ANTHROPIC_API_KEY=
